// =============================================================================
//  cmake/version.rc.in —— exe 的版本资源（Windows VERSIONINFO）
//
//  【它由 CMake 在 configure 期生成】模板变量全部来自顶层 `project(VERSION ...)`
//  ⇒ 与 `WAG_ENGINE_VERSION` 宏、`session.json` 的 `engine` **同一个来源**
//     （《蓝图控制台文档》§3.2.3："一处定义、两处呈现"）。
//
//  【写什么、不写什么】（§3.2.3.1，2026-11-14 定）
//      写  ：FileVersion / ProductVersion（同值）+ ProductName
//      不写：CompanyName / Comments；**也不写"诊断格式版本"**
//            —— 那是**协议**版本（`version:1`），不是 exe 的属性。
// =============================================================================

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         0x40004L
 FILETYPE       0x1L
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileVersion",    "@PROJECT_VERSION@\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@\0"
            VALUE "ProductName",    "LuaWAG\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
